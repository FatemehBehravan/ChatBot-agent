# Copy to .env — never commit real values.

# --- Local model (OpenAI-compatible endpoint; e.g. Ollama) ---
# The Compose profile `local-llm` serves Ollama at http://ollama:11434/v1.
# Ollama on the host instead: http://host.docker.internal:11434/v1
LOCAL_BASE_URL=http://ollama:11434/v1
LOCAL_API_KEY=not-needed
LOCAL_MODEL=qwen2.5:7b-instruct

# --- Hosted API model (OpenAI-compatible gateway) ---
# The key stays in .env only. This example keeps a placeholder key.
REMOTE_BASE_URL=https://api.gapgpt.app/v1
REMOTE_API_KEY=replace-me
REMOTE_MODEL=gemini-2.5-flash-lite

# --- Embeddings (optional) ---
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# --- App ---
# stub (default, no network), local, remote, or route (local vs hosted per step).
APP_PROVIDER=stub
APP_ENV=dev
LOG_LEVEL=info
DATA_DIR=/app/data
STATE_DIR=/app/.state
DATABASE_URL=            # e.g. sqlite:////app/.state/app.db or postgresql://user:pass@db:5432/app
