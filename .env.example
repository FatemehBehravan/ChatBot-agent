# Copy to .env — never commit real values.

# --- Local model (OpenAI-compatible endpoint; e.g. Ollama) ---
# From inside a container, reach the host's Ollama via host.docker.internal,
# or use http://ollama:11434/v1 together with the `local-llm` compose profile.
LOCAL_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_API_KEY=not-needed
LOCAL_MODEL=qwen2.5:7b-instruct

# --- Hosted API model (any OpenAI-compatible provider / gateway) ---
REMOTE_BASE_URL=https://api.example-provider.com/v1
REMOTE_API_KEY=replace-me
REMOTE_MODEL=replace-with-a-low-cost-model

# --- Embeddings (optional) ---
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# --- App ---
# Stage 1 serves only the stub provider. Later stages use local or remote.
APP_PROVIDER=stub
APP_ENV=dev
LOG_LEVEL=info
DATA_DIR=/app/data
STATE_DIR=/app/.state
DATABASE_URL=            # e.g. sqlite:////app/.state/app.db or postgresql://user:pass@db:5432/app
